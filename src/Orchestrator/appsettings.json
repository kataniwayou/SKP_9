{
  // Local-development defaults, and nothing else. Every value here is overridden in the cluster by
  // an environment variable in k8s/36-orchestrator.yaml -- Service__*, ConnectionStrings__Redis,
  // RabbitMq__*, ConsoleHealth__Port and the OTLP/probe-logging knobs -- so this file exists so that
  // `dotnet run` from a clone works against a locally reachable Redis and broker, not to describe
  // production.
  //
  // There is no Postgres connection string here and there must not be one: this process is a
  // broker and Redis consumer of the API's projections and never opens the database. Nor is there a
  // replica identity -- InstanceId.Resolve reads POD_NAME, and off-cluster it falls back to the
  // machine name, which is what a single local run wants.
  //
  // Only keys the code actually reads appear here. L2GateOptions' four values are one coupled
  // budget and stay in that class; the OTLP exporter is configured entirely from OTEL_*
  // environment variables, which is why there is no OpenTelemetry section.
  "Service": {
    "Name": "orchestrator",
    "Version": "0.0.0"
  },
  "ConnectionStrings": {
    // Required -- AddBaseConsoleRedis fails fast without it. abortConnect=false so the multiplexer
    // materialises against a Redis that is not up yet and fails per-operation instead of throwing
    // during startup.
    "Redis": "localhost:6379,abortConnect=false,connectTimeout=5000"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/"
  },
  "ConsoleHealth": {
    // The embedded probe listener's port, and the one the manifest's three probes dial. Deliberately
    // not an application port: this process has no inbound surface of its own.
    "Port": 8081
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Quartz": "Warning"
    }
  }
}
