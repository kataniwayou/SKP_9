  },
  {
   "id": "5e2c9da8-ff4a-441d-be96-f658ec0d1ab3",
   "name": "archive-document",
   "version": "2.0.0",
   "description": "ArchiveExpander output = ArchiveCollapser input: metadata plus content, depth 2. Supersedes archive-expander-document v1.0.0, which was depth 1 and is frozen."
  },
  {
   "id": "b3877a36-ba2f-4893-8b46-f91413b12384",
   "name": "file-locator",
   "version": "1.0.0",
   "description": "KafkaImporter output = FileFetcher input: the absolute path of one file. Does NOT assert absoluteness -- Path.IsPathFullyQualified is platform-dependent and no regex approximates it."
  },
  {
   "id": "e33f8079-7c65-49de-9a1c-bcd1065e9044",
   "name": "archive-document",
   "version": "3.0.0",
   "description": "ArchiveExpander output = ArchiveCollapser input: one self-referencing node, any depth. Supersedes archive-document v2.0.0, which unrolled the same shape to a fixed depth 2 and is frozen. The depth ceiling is now MaxDepth alone -- there is no second number for a step payload to disagree with."
  },
  {
   "id": "aa662cc3-a72b-41ed-9de6-8dc09aeed4b6",
   "name": "kafka-importer-config",
   "version": "1.0.0",
   "description": "KafkaImporter step payload: which topic to drain, under which group, and the two bounds the framework's ImporterConfig enforces. The broker is NOT here -- it is an address, so it lives in Kafka__BrokerList in the manifest."
  },
  {
   "id": "f09a684c-a516-459b-8c43-e415feb85469",
   "name": "kafka-exporter-config",
   "version": "1.0.0",
   "description": "KafkaExporter step payload: the destination topic and the delivery timeout the cached producer is built with. The broker is not here, for the same reason it is absent from the importer's."
  },
  {
   "id": "ad718b82-64c2-467a-88d3-54fd9beefb61",
   "name": "file-fetcher-config",
   "version": "1.0.0",
   "description": "FileFetcher step payload: everything knowable from FileInfo before the file is opened. allowedExtensions entries carry a leading dot or are the '*.*' sentinel; absent, null or empty widens to ['*.*']. minimumSizeBytes 0 disables the floor."
  },
  {
   "id": "9268ba11-76e7-4e2f-bc34-2fe0abba167f",
   "name": "archive-expander-config",
   "version": "1.0.0",
   "description": "ArchiveExpander step payload: how many levels of archive to expand. Absent means 1. The upper bound is NOT stated here -- MaxSupportedDepth is a compile-time constant checked before a file is opened, and repeating it in a frozen schema row is the coupling archive-document v2.0.0 had."
  },
  {
   "id": "6a0df347-1501-4c1b-b004-d25adfe3e312",
   "name": "archive-collapser-config",
   "version": "1.0.0",
   "description": "ArchiveCollapser step payload: empty. The processor takes no decisions from a step -- what to pack is entirely the document's shape. Registered rather than left null so an empty payload is a stated contract instead of an absence, and so a field added later has somewhere to land."
  },
  {
   "id": "8615d18f-6557-4176-a101-cb6736f3ade9",
   "name": "file-persister-config",
   "version": "1.0.0",
   "description": "FilePersister step payload: the folder written into. Absolute, and it must already exist -- the processor refuses to create it, because an absent folder means the volume is not mounted. The file NAME is not here; it rides the envelope."
  },
  {
   "id": "32c21d58-5cc0-440d-a50d-fdd6690ab6fc",
   "name": "sample-config",
   "version": "1.0.0",
   "description": "Processor.Sample step payload: a number and an optional label, both carried only so a sample step can be told apart from its neighbours in a log."
  },
  {
   "id": "ef246bdb-3f17-4ef5-9d97-ca5f1e44a38d",
   "name": "archive-document-twin",
   "version": "3.0.0",
   "description": "Byte-identical copy of archive-document 3.0.0. Exists to ask whether the edge gate compares schemas or ids."
  },
  {
   "id": "68ef4073-d046-46ce-9056-ef6f6af01c18",
   "name": "archive-document-tightened",
   "version": "3.1.0",
   "description": "archive-document 3.0.0 plus a required metadata.provenanceTag the expander never emits."
  },
  {
   "id": "f33d3018-66ec-4ece-ba7c-b1722a76341c",
   "name": "file-locator-open",
   "version": "1.1.0",
   "description": "file-locator 1.0.0 with additionalProperties removed, so an unknown key is accepted."
  },
  {
   "id": "4fe92a0c-5cc8-447f-8148-975152c09908",
   "name": "sk-normalizer-config-v4",
   "version": "4.0.0",
   "description": "SKNormalizer step payload. Supersedes sk-normalizer-config-v3 3.0.0, which declared cacheAddress -- the full L2 address, authored by hand into the step payload. The record now declares cacheRoot, the dictionary's NAME alone, and composes skp:{workflowId}:cache:{root} from the workflow id the dispatch already carries. A referenced definition cannot be edited, so renaming a property needs a new row."
  },
  {
   "id": "9fa8528f-1e18-465a-b8f2-645001de7312",
   "name": "analyst-config",
   "version": "1.0.0",
   "description": "Analyst step payload: what to investigate, how far back, the panels it may read, and the three hard ceilings. The loop contract is compiled, so a payload edit cannot break the typed exit."
  },
  {
   "id": "94eb15c9-083f-4ab4-8792-eee383a0fc86",
   "name": "analyst-finding",
   "version": "1.0.0",
   "description": "Analyst output document. Quiet and Indeterminate verdicts are deliberately absent: a quiet run cancels the step and an unanalysable one fails it, so neither reaches a document."
  },
  {
   "id": "4bd46792-3ce5-4279-ab83-4384994542cd",
   "name": "analyst-finding",
   "version": "2.0.0",
   "description": "Analyst output document v2: target, insights (each correlating two or more read panels) instead of a narrative, and usage against the budget. Quiet and Indeterminate verdicts are absent: no insight or unbelievable evidence cancels the step, a failed facility fails it."
  },
  {
   "id": "d9021988-b5a7-41e5-90a9-ea0362669aa6",
   "name": "analyst-finding",
   "version": "3.0.0",
   "description": "Analyst output document v3: every run whose facilities worked is published. Drifting/Notable carry correlated insights; Quiet (nothing correlated into anything wrong) and Inconclusive (evidence judged unbelievable) carry a reason instead. A facility failure fails the step and publishes nothing."
  },
  {
   "id": "4a203429-8379-42fb-a674-c4242bb37619",
   "name": "analyst-config",
   "version": "2.0.0",
   "description": "Analyst step payload v2: adds an optional expectations object (declared tolerated failed/cancelled share, with a reason; at least one bound required) so a declared, expected failure rate reads as Quiet."
  },
  {
   "id": "ebc7e9d3-b02c-4e62-bb02-fb86464793d9",
   "name": "analyst-finding",
   "version": "4.0.0",
   "description": "Analyst output document v4: every insight carries classification (deterministic/transient), domain (system/data), severity, onset and evidenceKinds; severity is tied to classification (deterministic=high, transient=low)."
  },
  {
   "id": "72a22cbf-de4b-4d6c-8077-329f5988fb5c",
   "name": "outcome-record",
   "version": "1.0.0",
   "description": "outcome-recorder output: a pointer to a step outcome (correlation id, predecessor's execution id when it had one, recorded-at) — never the reason or the payload"
  },
  {
   "id": "e2997001-3711-4ef6-9af9-0dcb4b60a69e",
   "name": "outcome-record",
   "version": "2.0.0",
   "description": "outcome-recorder output: a pointer to a step outcome (correlation id, predecessor's execution id when it had one, the recorder's own workflow/step/processor position, recorded-at) — never the reason or the payload"
  }
