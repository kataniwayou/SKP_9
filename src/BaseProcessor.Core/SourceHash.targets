<Project>

  <!--
    SourceHash.targets (IDENT-01/02, Phase 28, D-01/D-02/D-03).

    Build-time code-identity: computes a reproducible SHA-256 over the .cs of the CONCRETE
    processor that imports this file, and embeds it as
    [assembly: AssemblyMetadata("SourceHash", "<64-hex>")] on that assembly. The runtime reader
    (AssemblyMetadataSourceHashProvider) reads the attribute off Assembly.GetEntryAssembly(), so it
    MUST land on the concrete .dll, never on BaseProcessor.Core (D-03).

    Shipped as build/BaseProcessor.Core.targets INSIDE the BaseProcessor.Core package, so NuGet
    imports it into every consumer automatically. That replaces the relative <Import> each concrete
    used to carry, which existed only because a ProjectReference does not flow build targets —
    a PackageReference does. A new concrete processor now gets identity by referencing the package,
    and can no longer ship without it by forgetting a line.

    THE FOLD IS THE CONCRETE ONLY, and that is a deliberate narrowing (2026-09-02). It used to span
    BaseProcessor.Core's 27 .cs files as well as the concrete's 4, which made a processor's identity
    87% framework — so a doc-comment fix in a library the processor merely consumes re-issued the
    identity of every processor built on it, and every registered row had to be repointed for a
    change that altered no behaviour. That happened at ac23c1e and again at 6d6a132.
    BaseProcessor.Core was in the fold only because it happened to be a ProjectReference in the same
    repo; as a versioned package it belongs in the same category as RabbitMQ.Client and the runtime
    patch level — a dependency, and out of scope. What guards a framework upgrade instead is the
    exact version pin and the lock file, not this hash.

    Algorithm (IDENT-01, locked): for each impl .cs:
      text = File.ReadAllText(p); text = text.Replace("\r\n","\n").Replace("\r","\n");  // LF-normalize CONTENT
      perFileHash = SHA256(UTF8(text));
    fold the per-file hashes in ORDINAL order of the forward-slash-normalized FullPath; the final
    SourceHash = SHA256(concatenated per-file hashes), lowercase 64-hex (b.ToString("x2")). Paths
    are forward-slash-normalized + ordinal-sorted so the hash is identical on Windows dev builds and
    Linux Docker builds (Pitfall 1).
  -->

  <!--
    (0) OPT-OUT, defaulting ON. Shipping these targets in the package's build/ folder means NuGet
    imports them into EVERY consumer of BaseProcessor.Core, not only concrete processors — the test
    project included, where a SourceHash attribute on the entry assembly is meaningless and, worse,
    latent: AssemblyMetadataSourceHashProvider is documented to THROW when the attribute is absent,
    and a test written against that fail-fast would silently read the test assembly's own hash
    instead. Default-on rather than opt-in, so a real processor still cannot ship without identity
    by forgetting a line; a non-processor consumer sets EmitProcessorSourceHash=false.
  -->

  <!-- (1) Inline RoslynCodeTaskFactory task — netstandard2.0 surface only; recompiled each build. -->
  <UsingTask TaskName="ComputeSourceHash" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Hash ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Class" Language="cs"><![CDATA[
public class ComputeSourceHash : Microsoft.Build.Utilities.Task
{
    [Microsoft.Build.Framework.Required]
    public Microsoft.Build.Framework.ITaskItem[] Files { get; set; }
    [Microsoft.Build.Framework.Output]
    public string Hash { get; set; }

    public override bool Execute()
    {
        // Ordinal sort on a normalized (forward-slash) full path for OS-independence (Pitfall 1).
        var paths = new System.Collections.Generic.List<string>();
        foreach (var f in Files) paths.Add(f.GetMetadata("FullPath").Replace('\\', '/'));
        paths.Sort(System.StringComparer.Ordinal);

        using (var outer = System.Security.Cryptography.SHA256.Create())
        using (var acc = new System.IO.MemoryStream())
        {
            foreach (var p in paths)
            {
                var text = System.IO.File.ReadAllText(p);              // UTF-8 default
                text = text.Replace("\r\n", "\n").Replace("\r", "\n"); // LF-normalize CONTENT (IDENT-01)
                using (var per = System.Security.Cryptography.SHA256.Create())
                {
                    var h = per.ComputeHash(System.Text.Encoding.UTF8.GetBytes(text));
                    acc.Write(h, 0, h.Length);                          // fold per-file hashes, in sorted order
                }
            }
            acc.Position = 0;
            var final = outer.ComputeHash(acc);
            var sb = new System.Text.StringBuilder(64);
            foreach (var b in final) sb.Append(b.ToString("x2"));       // lowercase 64-hex (IDENT-01)
            Hash = sb.ToString();
        }
        return true;
    }
}
      ]]></Code>
    </Task>
  </UsingTask>

  <!--
    (2) Implementation-file set: the importing concrete project's own .cs, and nothing else.
    BaseProcessor.Core, BaseConsole.Core and Messaging.Contracts are all packages now, so no glob
    can reach them and none should. Excluding obj is LOAD-BEARING rather than tidy: the generated
    AssemblyInfo carries the PREVIOUS hash, so folding it in would make the hash self-referential
    and it would never settle.
  -->
  <ItemGroup Condition="'$(EmitProcessorSourceHash)' != 'false'">
    <ImplFiles Include="$(MSBuildProjectDirectory)\**\*.cs"
               Exclude="$(MSBuildProjectDirectory)\obj\**\*.cs;$(MSBuildProjectDirectory)\bin\**\*.cs;**\*.g.cs;**\*GlobalUsings*.cs;**\*AssemblyInfo*.cs" />
  </ItemGroup>

  <!--
    (3) Two-target compute/emit split (Pitfall 2). The INCREMENTAL compute target re-hashes only when
    an impl .cs changes (Inputs/Outputs stamp); the ALWAYS-RUN emit target reads the stamp back when
    compute was skipped and adds the AssemblyAttribute UNCONDITIONALLY, so an incremental no-change
    build still carries the attribute (never dropped → the reader fail-fast can never trip from a skip).
  -->
  <!--
    Hook BEFORE the SDK's CoreGenerateAssemblyInfo (which materializes @(AssemblyAttribute) via its
    GetAssemblyAttributes dependency) — NOT merely BeforeTargets="CoreCompile". GenerateAssemblyInfo
    itself runs BeforeTargets="CoreCompile" and depends on CoreGenerateAssemblyInfo, so a plain
    CoreCompile hook is NOT guaranteed to add the item before the SDK collects it (the attribute would
    silently never embed). BeforeTargets="CoreGenerateAssemblyInfo" guarantees the item is present.
  -->
  <Target Name="ComputeSourceHash" BeforeTargets="CoreGenerateAssemblyInfo;CoreCompile"
          Condition="'$(EmitProcessorSourceHash)' != 'false'"
          Inputs="@(ImplFiles)" Outputs="$(IntermediateOutputPath)sourcehash.stamp">
    <ComputeSourceHash Files="@(ImplFiles)">
      <Output PropertyName="SourceHash" TaskParameter="Hash" />
    </ComputeSourceHash>
    <WriteLinesToFile File="$(IntermediateOutputPath)sourcehash.stamp" Lines="$(SourceHash)" Overwrite="true" />
  </Target>

  <!--
    (3a) STALE-EMBED GUARD (Pitfall 2b). Without this, an INCREMENTAL build can PRINT the new
    SourceHash while leaving the OLD one embedded in the assembly — the most dangerous possible
    failure for a value whose whole job is code identity.

    Mechanism: the SDK's CoreGenerateAssemblyInfo is itself incremental on
    Inputs="$(MSBuildAllProjects)" — the PROJECT files — NOT on @(AssemblyAttribute). So when a .cs
    in @(ImplFiles) changes (the hash changes with it) but the .csproj does not — which is the
    ordinary case for every edit — ComputeSourceHash re-runs and EchoSourceHash prints the NEW hash,
    yet CoreGenerateAssemblyInfo is skipped as up-to-date and $(GeneratedAssemblyInfoFile) keeps the
    PREVIOUS AssemblyMetadata("SourceHash", ...). CoreCompile then has no changed input, so the .dll
    ships the stale value. Docker builds are immune (always clean); host incremental builds are not.

    Observed 2026-07-27: build log said be9c0fe7…, Processor.Sample.dll carried e2f0e743… (three
    hashes stale). Registering the printed hash then deploying that binary is an identity mismatch —
    the container never resolves its processor row and Start 422s on the liveness gate.

    Fix: an Inputs/Outputs target that fires ONLY when the stamp is newer than the generated
    AssemblyInfo, and deletes that file. CoreGenerateAssemblyInfo then sees its output missing and
    regenerates with the current attribute; CoreCompile sees a changed source and rebuilds. Ordered
    BeforeTargets="CoreGenerateAssemblyInfo" and DependsOnTargets="ComputeSourceHash" so the stamp is
    always fresh before the comparison. When the hash has NOT changed the stamp is not rewritten, so
    this target is skipped and incrementality is fully preserved.
  -->
  <Target Name="InvalidateAssemblyInfoOnSourceHashChange"
          Condition="'$(EmitProcessorSourceHash)' != 'false'"
          BeforeTargets="CoreGenerateAssemblyInfo"
          DependsOnTargets="ComputeSourceHash"
          Inputs="$(IntermediateOutputPath)sourcehash.stamp"
          Outputs="$(GeneratedAssemblyInfoFile)">
    <Message Text="SourceHash changed — regenerating $(GeneratedAssemblyInfoFile)" Importance="high" />
    <Delete Files="$(GeneratedAssemblyInfoFile)" />
  </Target>

  <Target Name="EmitSourceHashAttribute" BeforeTargets="CoreGenerateAssemblyInfo;CoreCompile"
          Condition="'$(EmitProcessorSourceHash)' != 'false'" DependsOnTargets="ComputeSourceHash">
    <!-- If ComputeSourceHash was skipped (no source change), recover the hash from the stamp. -->
    <ReadLinesFromFile File="$(IntermediateOutputPath)sourcehash.stamp" Condition="'$(SourceHash)' == ''">
      <Output TaskParameter="Lines" PropertyName="SourceHash" />
    </ReadLinesFromFile>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>SourceHash</_Parameter1>
        <_Parameter2>$(SourceHash)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <!--
    (3b) Echo the computed SourceHash into the build output. AfterTargets="EmitSourceHashAttribute"
    (NOT ComputeSourceHash): on an incremental no-source-change build ComputeSourceHash is skipped by its
    Inputs/Outputs stamp and $(SourceHash) is empty until EmitSourceHashAttribute reads it back from the
    stamp — so anchoring here guarantees the value is populated in BOTH the fresh-compute and
    incremental-skip paths. Importance="high" prints at the default `dotnet build` (minimal) verbosity;
    the project name distinguishes concretes in a multi-project build (Processor.Sample, BaseApi.Tests, …).
  -->
  <Target Name="EchoSourceHash" AfterTargets="EmitSourceHashAttribute"
          Condition="'$(EmitProcessorSourceHash)' != 'false'">
    <Message Text="SourceHash ($(MSBuildProjectName)): $(SourceHash)" Importance="high" />
  </Target>

</Project>
