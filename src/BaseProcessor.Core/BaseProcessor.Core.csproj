<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="BaseConsole.Core" VersionOverride="[1.0.0]" />
    <PackageReference Include="Messaging.Contracts" VersionOverride="[1.0.0]" />
    <PackageReference Include="Messaging.Transport" VersionOverride="[1.0.0]" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BaseApi.Tests" />
  </ItemGroup>

  <!--
    Packed, not project-referenced. The .nupkg lands beside this project's own source in
    nuget/<version>/, which NuGet.config registers as a folder source. Consumers pin the version
    exactly; see Directory.Packages.props for why it is overwritten rather than bumped.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Version>1.0.0</Version>
    <PackageOutputPath>$(MSBuildProjectDirectory)\nuget\$(Version)</PackageOutputPath>
    <!-- Both are required rather than decorative: TreatWarningsAsErrors is on repo-wide, and a
         pack without them raises NU5017/NU5128-class warnings that would fail the build. -->
    <Description>Processor host infrastructure: two-stage identity boot, schema resolution, dispatch pipeline, liveness.</Description>
    <Authors>SKP</Authors>
  </PropertyGroup>

  <!--
    Shipped as a package build asset, NOT merely as a file in this repo. NuGet automatically
    imports build/<PackageId>.targets into every consuming project, which is what gives a concrete
    processor its code identity without remembering an <Import> line. A ProjectReference could not
    do this, which is the only reason that manual import existed.
  -->
  <ItemGroup>
    <None Include="SourceHash.targets" Pack="true" PackagePath="build/BaseProcessor.Core.targets" />
  </ItemGroup>

</Project>
