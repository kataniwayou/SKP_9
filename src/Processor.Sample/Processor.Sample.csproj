<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The first concrete processor: a thin shell. It carries no identity, liveness, broker or Redis code
    of its own — AddBaseProcessor folds all of it in — and today it carries no work either. It exists
    to be deployed and observed: to prove that a processor boots, discovers who it is, publishes
    liveness and answers its probes.

    Common properties (net8.0, Nullable, ImplicitUsings, TreatWarningsAsErrors) come from
    Directory.Build.props, and package versions from Directory.Packages.props — never declare either
    here.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Processor.Sample</RootNamespace>
    <AssemblyName>Processor.Sample</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The worker SDK does not copy appsettings.json on its own. -->
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      No <Import> of SourceHash.targets accompanies this, and that is the point: the package ships
      the targets in its build/ folder, which NuGet imports automatically. A ProjectReference could
      not flow build targets, which is the only reason a manual import ever existed here. The hash
      those targets stamp on THIS assembly — the entry assembly, where the runtime reader looks — is
      the identity the API matches a processor row against, and it now folds this project's own .cs
      and nothing else.
    -->
    <PackageReference Include="BaseProcessor.Core" VersionOverride="[1.0.0]" />
  </ItemGroup>

</Project>
