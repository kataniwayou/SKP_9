<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BaseApi.Tests</RootNamespace>
    <AssemblyName>BaseApi.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- BaseProcessor.Core's package auto-imports SourceHash.targets into every consumer.
         This assembly is not a processor, and stamping a hash on it would give
         AssemblyMetadataSourceHashProvider something to find on the entry assembly, hiding
         the fail-fast it exists to perform. -->
    <EmitProcessorSourceHash>false</EmitProcessorSourceHash>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <!--
    THREE referenced projects each contribute an appsettings.json to this output directory
    — BaseApi.Service, Orchestrator and Processor.Sample — and they all land on the same
    path. Which one wins is decided by file timestamps, so the ambient configuration these
    tests build hosts against was silently non-deterministic, and `dotnet publish` of this
    project would fail outright with NETSDK1152 on the duplicate.

    No test depends on it: every one that builds a host supplies its own keys through
    AddInMemoryCollection, which is applied after the file and therefore wins. So the fix is
    to take none of them rather than to pick one — an ambient file nothing reads is just a
    trap for the next person who adds a test and wonders where a value came from.
  -->
  <!--
    THREE referenced projects each contribute an appsettings.json to this output directory
    — BaseApi.Service, Orchestrator and Processor.Sample — and all three target the same
    relative path. Whichever copies last wins, so the ambient configuration a test host reads
    was decided by file timestamps, and `dotnet publish` of this project failed outright with
    NETSDK1152 on the duplicate.

    ALL THREE ARE REMOVED HERE, rather than one being chosen. No test needs an ambient file:
    every one that builds a host supplies its keys through AddInMemoryCollection, which is
    registered after the JSON provider and wins. Picking a winner would fix the publish error
    and keep the real hazard — a test that forgot a key would silently inherit some service's
    default and pass for the wrong reason.

    A REMOVAL AFTER THE FACT, not a suppression of the copy, and that is a deliberate second
    choice. Two attempts to stop the copy failed: an ItemGroup Remove on
    AllItemsFullPathWithTargetPath AfterTargets="GetCopyToOutputDirectoryItems" (the item is
    already resolved by then) and one on _SourceItemsToCopyToOutputDirectory /
    ReferenceCopyLocalPaths BeforeTargets="_CopyOutOfDateSourceItemsToOutputDirectory" (wrong
    lists — transitive content arrives by another path). The two targets below are blunt but
    deterministic, and they cover the two places the file appears: the build output and the
    publish list. If someone later finds the item that actually carries it, replacing these
    with a real suppression is strictly better.
  -->
  <Target Name="RemoveTransitiveAppSettingsFromOutput" AfterTargets="Build">
    <Delete Files="$(OutputPath)appsettings.json" ContinueOnError="true" />
  </Target>

  <Target Name="RemoveTransitiveAppSettingsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="'%(Filename)%(Extension)' == 'appsettings.json'" />
    </ItemGroup>
  </Target>



  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resilience\Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.v3.assert" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BaseApi.Core" VersionOverride="[1.0.0]" />
    <ProjectReference Include="..\..\BaseApi.Service\BaseApi.Service.csproj" />
    <PackageReference Include="BaseConsole.Core" VersionOverride="[1.0.0]" />
    <PackageReference Include="Messaging.Transport" VersionOverride="[1.0.0]" />
    <PackageReference Include="BaseProcessor.Core" VersionOverride="[1.0.0]" />
    <ProjectReference Include="..\..\Processor.Sample\Processor.Sample.csproj" />
    <ProjectReference Include="..\..\Orchestrator\Orchestrator.csproj" />
  </ItemGroup>

</Project>
