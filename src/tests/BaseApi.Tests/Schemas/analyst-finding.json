{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Analyst finding v4",
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "Drifting",
        "Notable",
        "Quiet",
        "Inconclusive"
      ],
      "description": "Notable carries at least one deterministic insight (operator intervention); Drifting carries only transient insights (lower severity); Quiet means no problem, or only what the declared expectations allow; Inconclusive means the evidence could not decide."
    },
    "target": {
      "type": "object",
      "properties": {
        "workflowId": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "workflowId",
        "name"
      ],
      "additionalProperties": false,
      "description": "The workflow investigated. name is read from L2 at export time and is null when it could not be read; workflowId is authoritative."
    },
    "window": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        },
        "samplesExamined": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "from",
        "to",
        "samplesExamined"
      ],
      "additionalProperties": false,
      "description": "The REALIZED window, not the configured one. Precision here is what lets two consecutive answers be compared, which is the only liveness signal a stateless agent has. format:date-time on from/to is documentation only -- ProcessorJsonSchemaValidator does not set RequireFormatValidation, so it is never enforced. No pattern is added either: unlike a hand-authored payload field, these values come from this processor's own serializer writing DateTimeOffset, so the only way they could be malformed is a bug in code we already test; the actual guarantee is the serializer, not this schema."
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "description": "Why there is no insight: set on Quiet and Inconclusive, null on Drifting and Notable."
    },
    "insights": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "panels": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "classification": {
            "type": "string",
            "enum": [
              "deterministic",
              "transient"
            ]
          },
          "domain": {
            "type": "string",
            "enum": [
              "system",
              "data"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "low"
            ]
          },
          "onset": {
            "type": "string",
            "minLength": 1
          },
          "evidenceKinds": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "nature",
                "logged-as",
                "persistence",
                "mix",
                "retry",
                "scope",
                "coincidence",
                "conservation"
              ]
            }
          }
        },
        "required": [
          "claim",
          "why",
          "panels",
          "classification",
          "domain",
          "severity",
          "onset",
          "evidenceKinds"
        ],
        "additionalProperties": false
      },
      "description": "What the analyst inferred, never what a panel showed. Each insight correlates at least two panels into a cause, a consequence or a contradiction no single panel shows; the readings themselves live in evidence. Non-empty exactly on Drifting and Notable."
    },
    "evidence": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "properties": {
          "panelId": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "panelId",
          "layer",
          "label",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "ruledOut": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hypothesis": {
            "type": "string",
            "minLength": 1
          },
          "disconfirmingCriterion": {
            "type": "string",
            "minLength": 1
          },
          "whatWasSeen": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "hypothesis",
          "disconfirmingCriterion",
          "whatWasSeen"
        ],
        "additionalProperties": false
      }
    },
    "trace": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "panelId": {
            "type": "string",
            "minLength": 1
          },
          "dataReturned": {
            "type": "boolean"
          },
          "historyFrom": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "historyTo": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "ordinal",
          "panelId",
          "dataReturned"
        ],
        "additionalProperties": false
      },
      "description": "How a reader tells 'checked and it was clean' from 'never looked'. Without it a wrong conclusion is unauditable."
    },
    "usage": {
      "type": "object",
      "properties": {
        "calls": {
          "type": "integer",
          "minimum": 0
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "elapsedSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "budget": {
          "type": "object",
          "properties": {
            "maxIterations": {
              "type": "integer",
              "minimum": 1
            },
            "maxTokens": {
              "type": "integer",
              "minimum": 1
            },
            "wallClockSeconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "maxIterations",
            "maxTokens",
            "wallClockSeconds"
          ],
          "additionalProperties": false
        },
        "dispatch": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "calls": {
              "type": "integer",
              "minimum": 0
            },
            "inputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "outputTokens": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "calls",
            "inputTokens",
            "outputTokens"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "calls",
        "inputTokens",
        "outputTokens",
        "elapsedSeconds",
        "budget",
        "dispatch"
      ],
      "additionalProperties": false,
      "description": "calls/tokens/elapsedSeconds are the investigation's own spend, the thing budget limits. dispatch is everything the dispatch spent at the model, the fitness gate included, which the budget does not cover; null only where no meter is wired."
    },
    "promptHash": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "verdict",
    "target",
    "window",
    "reason",
    "insights",
    "evidence",
    "ruledOut",
    "trace",
    "usage",
    "promptHash"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "enum": [
              "Drifting",
              "Notable"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "insights": {
            "minItems": 1
          },
          "evidence": {
            "minItems": 1
          },
          "reason": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "insights": {
            "maxItems": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
