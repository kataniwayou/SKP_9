{
  // Local-development defaults, and nothing else. Every value here is overridden in the cluster by
  // an environment variable in k8s/30-baseapi-service.yaml -- Service__*, ConnectionStrings__*,
  // RabbitMq__* and the OTLP/probe-logging knobs -- so this file exists so that `dotnet run` from a
  // clone works against a locally reachable Postgres, Redis and broker, not to describe production.
  //
  // Only keys the code actually reads appear here. Defaults that live in an options class stay
  // there: L2GateOptions' four values are one coupled budget (see its remarks) and
  // Health:ReadinessFailureThreshold tracks the readiness probe's failureThreshold in the manifest.
  // Restating either would be a second copy nothing keeps in step.
  //
  // The OTLP exporter is configured entirely from OTEL_* environment variables, which is why there
  // is no OpenTelemetry section: with none set the SDK still works and export simply fails quietly.
  "Service": {
    "Name": "baseapi",
    "Version": "0.0.0"
  },
  "ConnectionStrings": {
    // Required -- AddBaseApi fails fast without it. Matches the credentials in k8s/01-secret.yaml so
    // a local Postgres stood up from that file needs no further edit.
    "Postgres": "Host=localhost;Port=5432;Database=stepsdb;Username=postgres;Password=postgres;Maximum Pool Size=20;Timeout=15",
    // abortConnect=false so the multiplexer materialises against a Redis that is not up yet and
    // fails per-operation instead of throwing during startup.
    "Redis": "localhost:6379,abortConnect=false,connectTimeout=5000"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/"
  },
  "Redis": {
    "ProcessorKeyTtlDays": 100,
    "Serialization": {
      "JsonOptions": "default"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",

      // ExceptionHandlerMiddleware logs "An unhandled exception has occurred while executing the
      // request." at ERROR for every exception that reaches it -- INCLUDING the ones our handlers
      // claim and turn into a deliberate 4xx. A validation refusal is a gate doing its job, and it
      // is already recorded by BaseApi.Core's Refusal line at Warning with the gate, the workflow
      // and the detail. Counting it as an Error too makes every error-rate alert count deliberate
      // schema rejections as faults, and a suite that exercises the gates generates them on purpose.
      //
      // NOTHING IS LOST FOR REAL FAULTS: FallbackExceptionHandler claims every unhandled exception
      // and logs it at Error WITH the exception and the path, which is strictly more than this
      // middleware's message carries. Silencing the category removes a duplicate, not a record.
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
    }
  },
  "AllowedHosts": "*"
}
