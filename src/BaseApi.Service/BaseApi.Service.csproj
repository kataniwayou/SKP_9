<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The runnable web API.

    Common build properties come from Directory.Build.props and package versions from
    Directory.Packages.props, so no PackageReference here carries a Version attribute.

    The Web SDK includes the ASP.NET Core framework reference automatically, so controllers,
    hosting and health checks need no package reference of their own.
  -->

  <PropertyGroup>
    <RootNamespace>BaseApi.Service</RootNamespace>
    <AssemblyName>BaseApi.Service</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BaseApi.Core" VersionOverride="[1.0.0]" />
    <PackageReference Include="Messaging.Contracts" VersionOverride="[1.0.0]" />
  </ItemGroup>

  <ItemGroup>
    <!-- Source generator for the [Mapper] partial classes. The asset attributes are required:
         see the convention note in Directory.Packages.props. -->
    <PackageReference Include="Riok.Mapperly"
                      PrivateAssets="all"
                      ExcludeAssets="runtime" />
    <!-- Design-time tooling for `dotnet ef`; must never flow as a transitive dependency. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design"
                      PrivateAssets="all" />
    <!-- Entity-specific validation: schema meta-validation and cron parsing. -->
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Cronos" />
    <!-- Redis client, used by the processor-liveness gate. -->
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

</Project>
