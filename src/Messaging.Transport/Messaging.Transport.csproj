<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- QueueSender.BuildProperties: SendAsync needs a live broker connection, so the property
         construction is the only part of a send a unit test can assert on. -->
    <InternalsVisibleTo Include="BaseApi.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RabbitMQ.Client" />
    <!-- ILogger<T> and IOptions<T>: RabbitMQ.Client does not carry these transitively, and this
         project deliberately has no FrameworkReference to Microsoft.AspNetCore.App. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Messaging.Contracts" VersionOverride="[1.0.0]" />
  </ItemGroup>

  <!--
    Packed, not project-referenced. The .nupkg lands beside this project's own source in
    nuget/<version>/, which NuGet.config registers as a folder source. Consumers pin the version
    exactly; see Directory.Packages.props for why it is overwritten rather than bumped.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Version>1.0.0</Version>
    <PackageOutputPath>$(MSBuildProjectDirectory)\nuget\$(Version)</PackageOutputPath>
    <!-- Both are required rather than decorative: TreatWarningsAsErrors is on repo-wide, and a
         pack without them raises NU5017/NU5128-class warnings that would fail the build. -->
    <Description>RabbitMQ transport: connection, topology declaration, queue send and receive, queue-depth probing.</Description>
    <Authors>SKP</Authors>
  </PropertyGroup>

</Project>
