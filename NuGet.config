<?xml version="1.0" encoding="utf-8"?>
<!--
  Offline restore. All packages resolve from the repo-local `nugets/` folder feed; nuget.org is
  cleared so a build never reaches the network and a missing package fails loudly at restore.
  The machine global-package fallback folders are cleared too, so restore is proven against the
  offline feed rather than a warm ~/.nuget/packages cache.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="offline" value="nugets" />
    <!-- This repo's own libraries. Each packable project owns its feed, so the package a consumer
         resolves sits beside the source it was built from. Folder sources are searched recursively,
         which is what makes the nuget/<version>/ layout work. -->
    <add key="messaging-contracts" value="src/Messaging.Contracts/nuget" />
    <add key="messaging-transport" value="src/Messaging.Transport/nuget" />
    <add key="baseconsole-core" value="src/BaseConsole.Core/nuget" />
    <add key="baseapi-core" value="src/BaseApi.Core/nuget" />
    <add key="baseprocessor-core" value="src/BaseProcessor.Core/nuget" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
