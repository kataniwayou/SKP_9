<Project>

  <!--
    Central Package Management. Every NuGet version used in the solution is pinned here;
    csproj files declare <PackageReference Include="..." /> with no Version attribute.

    Source-generator and design-time packages need asset attributes in the CONSUMING csproj
    (CPM does not control these):

      Riok.Mapperly                          PrivateAssets="all" ExcludeAssets="runtime"
        Build-time source generator. PrivateAssets stops the analyzer leaking to downstream
        consumers; ExcludeAssets="runtime" avoids loading a runtime DLL that is never used.

      Microsoft.EntityFrameworkCore.Design   PrivateAssets="all"
        `dotnet ef` tooling — must never flow as a transitive dependency.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- EF Core 8 — kept in lockstep with the .NET runtime patch -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.27" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.27" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.27" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.27" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.10" />
    <!-- Npgsql must stay on the 8.x line. The EF Core provider 8.0.10 binds to Npgsql 8.x
         internals that 9.0.0 removed, so pinning 9.x throws TypeLoadException at runtime when
         the provider bootstraps its type mapping. 8.0.9 is the latest 8.x release and satisfies
         the provider's `Npgsql >= 8.0.5` constraint. -->
    <PackageVersion Include="Npgsql" Version="8.0.9" />
    <PackageVersion Include="EFCore.NamingConventions" Version="8.0.3" />

    <!-- Mapping (source generator) -->
    <PackageVersion Include="Riok.Mapperly" Version="4.3.1" />

    <!-- Validation -->
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />

    <!-- Observability — core, hosting and OTLP exporter move together -->
    <PackageVersion Include="OpenTelemetry" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <!-- Instrumentation packages version on their own cadence -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.0" />
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="8.0.4" />

    <!-- Domain validators -->
    <PackageVersion Include="JsonSchema.Net" Version="9.2.1" />
    <PackageVersion Include="Cronos" Version="0.13.0" />

    <!-- Scheduling. Quartz has no PackageReference anywhere — it arrives transitively through
         the hosting package — but its PackageVersion is REQUIRED all the same: this SDK enables
         central transitive pinning by default, so the lock files record Quartz as a CentralTransitive
         dependency and a locked-mode restore fails with NU1004 the moment this line is missing.
         The same is true of Asp.Versioning.Http below. Neither line is safe to tidy away. -->
    <PackageVersion Include="Quartz" Version="3.18.1" />
    <PackageVersion Include="Quartz.Extensions.Hosting" Version="3.18.1" />

    <!-- Health checks -->
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />

    <!-- HTTP — API versioning and Swagger. Asp.Versioning.Mvc is the package that resolves
         [ApiController] + [ApiVersion] attributes for controllers; ApiExplorer is required for
         SubstituteApiVersionInUrl and GroupNameFormat. -->
    <!-- Transitive-only, and pinned for the NU1004 reason spelled out on Quartz above. -->
    <PackageVersion Include="Asp.Versioning.Http" Version="8.1.0" />
    <PackageVersion Include="Asp.Versioning.Mvc" Version="8.1.0" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.9.0" />

    <!-- Tests -->
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.v3.assert" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />

    <!-- Microsoft.Extensions.* family versions on its own cadence -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="8.10.0" />
    <!-- Logging/options abstractions for Messaging.Transport, which has no FrameworkReference to
         pull these in transitively the way BaseApi.Core's ASP.NET Core reference does. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <!-- Health checks and hosting for BaseConsole.Core -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="8.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />

    <!-- Redis L2 projection client -->
    <PackageVersion Include="StackExchange.Redis" Version="2.13.1" />

    <!-- Raw AMQP client. The 7.x line is the async IChannel API: BasicPublishAsync,
         BasicConsumeAsync, BasicAckAsync/BasicNackAsync and the *Async event handlers
         (ChannelShutdownAsync, RecoverySucceededAsync). The 6.x names are sync and different.

         MassTransit was removed deliberately. Its receive pipeline acks a faulted delivery to a
         <queue>_error queue rather than nacking, so a genuine dead-letter exchange is unreachable
         and pause/resume needs the ConnectReceiveEndpoint handle dance. Both are native here. -->
    <PackageVersion Include="RabbitMQ.Client" Version="7.1.2" />

    <!-- Drives orchestrator leader election over a coordination.k8s.io/v1 Lease. The 15.x line
         carries advisory GHSA-w7r3-mgwf-4mqq, which NuGetAudit promotes to a build error here,
         so the pin is 18.0.13 — a stable net8.0 release exposing the same LeaderElector API. -->
    <PackageVersion Include="KubernetesClient" Version="18.0.13" />

    <!-- This repo's own libraries, consumed as packages rather than project references. Each is
         packed by its own project into src/<Project>/nuget/<version>/ and resolved from there
         through the folder sources in NuGet.config.

         Pinned EXACTLY, in bracket notation, so a consumer can never float onto a version that
         happens to be present. The version is overwritten in place rather than bumped: repacking
         replaces the .nupkg, and making that visible to a consumer — clearing the extracted copy
         and restoring again — is the packing developer's step, not something restore infers. -->
    <PackageVersion Include="Messaging.Contracts" Version="[1.0.0]" />
    <PackageVersion Include="Messaging.Transport" Version="[1.0.0]" />
    <PackageVersion Include="BaseConsole.Core" Version="[1.0.0]" />
    <PackageVersion Include="BaseApi.Core" Version="[1.0.0]" />
    <PackageVersion Include="BaseProcessor.Core" Version="[1.0.0]" />
  </ItemGroup>

</Project>
