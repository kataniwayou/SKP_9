    <mxCell id="api" value="&lt;b&gt;BaseApi.Service&lt;/b&gt; (Deployment)&lt;br&gt;&lt;br&gt;ASP.NET Core REST · EF Core migrations applied on startup&lt;br&gt;Features: Workflow · Step · Assignment · Processor&lt;br&gt;Schema · Lookup · Orchestration · Cache&lt;br&gt;/health/startup flips green only once the schema is in place" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontColor=#1a1a1a;align=center;" vertex="1" parent="cp">
