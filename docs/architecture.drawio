    <mxCell id="cp" value="Control plane — namespace &lt;b&gt;skp&lt;/b&gt; (kind cluster &quot;desktop&quot;)" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;horizontal=1;rounded=1;arcSize=4;" vertex="1" parent="1">
