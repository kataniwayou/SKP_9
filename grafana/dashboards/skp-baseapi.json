      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "((sum(increase(dns_lookup_duration_seconds_count{service_name=~\"$service_name\",service_instance_id=~\"$service_instance_id\",error_type!=\"\"}[5m])) or vector(0)) > (clamp_min((sum(dns_lookup_duration_seconds_count{service_name=~\"$service_name\",service_instance_id=~\"$service_instance_id\",error_type!=\"\"}) or vector(0)) - (sum(dns_lookup_duration_seconds_count{service_name=~\"$service_name\",service_instance_id=~\"$service_instance_id\",error_type!=\"\"} offset 5m) or vector(0)), 0))) or (clamp_min((sum(dns_lookup_duration_seconds_count{service_name=~\"$service_name\",service_instance_id=~\"$service_instance_id\",error_type!=\"\"}) or vector(0)) - (sum(dns_lookup_duration_seconds_count{service_name=~\"$service_name\",service_instance_id=~\"$service_instance_id\",error_type!=\"\"} offset 5m) or vector(0)), 0))",
          "legendFormat": "",
          "range": true,
          "editorMode": "code"
        }
