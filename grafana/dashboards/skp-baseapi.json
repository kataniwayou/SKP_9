    {
      "id": 13,
      "type": "timeseries",
      "title": "In-flight and Kestrel connections",
      "description": "Legend: `in-flight|connections|queued {{service_instance_id}}`",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
