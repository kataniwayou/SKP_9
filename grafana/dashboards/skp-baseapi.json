      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (http_route,service_instance_id) (rate(http_server_request_duration_seconds_count{service_name=~\"$service_name\",service_version=~\"$service_version\",service_instance_id=~\"$service_instance_id\"}[$__rate_interval]))",
          "legendFormat": "{{http_route}} {{service_instance_id}}",
          "range": true,
          "editorMode": "code"
