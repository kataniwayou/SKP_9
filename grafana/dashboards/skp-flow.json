    {
      "id": 8,
      "type": "stat",
      "title": "Consuming",
      "description": "Minimum across every queue in the deployment, over replicas that have reported in the last 100s.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 18,
        "y": 1
