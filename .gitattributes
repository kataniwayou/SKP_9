# Force LF line endings for all text files on checkout — Windows dev host, Linux containers.

* text=auto eol=lf
# Binary file types — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.tgz binary
*.dll binary
*.exe binary
*.so binary
*.dylib binary
*.pdb binary
*.snk binary
*.pfx binary
# The vendored ffmpeg has NO EXTENSION, so none of the rules above reach it and `* text=auto` is
# the only thing standing between a 78MB executable and CRLF normalisation on a Windows checkout.
# text=auto does sniff content and would probably leave it alone; "probably" is not a guarantee
# worth taking on the one file the SKNormalizer image cannot start without.
vendor/ffmpeg/** binary
# Diff settings
*.cs diff=csharp
*.csproj diff=xml
*.props diff=xml
*.targets diff=xml
*.sln merge=union
vendor/ffmpeg/linux-x64/ffmpeg filter=lfs diff=lfs merge=lfs -text
